# Copy this file to .env and fill in real values. Never commit .env.

# SQLite database file. Relative paths are relative to prisma/schema.prisma.
# On Railway, point this at the volume: file:/data/prod.db
DATABASE_URL="file:./dev.db"

# Folder for uploaded unit photos. Defaults to ./uploads.
# On Railway, point this at the volume: /data/uploads
# UPLOADS_DIR=/data/uploads

# Signs login tokens. At least 32 characters; the API won't start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login lasts (e.g. 24h, 7d, 3600 for seconds).
JWT_EXPIRES_IN=24h

# Port the API listens on.
PORT=3001

# Frontend origin(s) allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:3000

# Which proxies to trust for the real client IP (rate limits are per IP).
# The frontend proxies /api through Next.js, so locally that's "loopback".
# Behind a load balancer use a hop count (e.g. 1) or Express trust-proxy value.
TRUST_PROXY=loopback

# Mark the session cookie Secure (HTTPS-only). Defaults to true when
# NODE_ENV=production; set to true for any HTTPS deployment.
COOKIE_SECURE=false
